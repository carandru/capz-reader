# Runtime identity. On a NAS/Linux host, set these to a UID/GID that can read your library.
PUID=1000
PGID=1000

# Web port on the host.
PORT=8020

# Root folder containing your PDF/EPUB library.
LIBRARY_PATH=./library

# Keep source books read-only unless you intentionally enable physical deletion.
LIBRARY_ACCESS=ro
ALLOW_DELETE_FILES=false

# Use true only when the app is served over HTTPS.
COOKIE_SECURE=false

AUTO_SCAN_ON_START=true
MISSING_RETENTION_DAYS=14
THUMB_WIDTH=320
PREVIEW_WIDTH=760
READER_WIDTH=1800
RENDER_CACHE_DAYS=30
RENDER_CACHE_LIMIT_GB=8
