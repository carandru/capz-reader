# Runtime identity. On a NAS, set these to the UID/GID that can read your PDF folders.
PUID=1000
PGID=1000

# Web port on the host.
PORT=8020

# PDF source folders. These may point to three completely different host locations.
# Relative defaults also work for a local test install.
NOVEL_PATH=./library/Novel
MANGA_PATH=./library/Manga
DOU_PATH=./library/Dou

# Keep source PDFs read-only unless you intentionally enable physical deletion.
LIBRARY_ACCESS=ro
ALLOW_DELETE_FILES=false

# Use true only when serving the app over HTTPS.
COOKIE_SECURE=false

AUTO_SCAN_ON_START=true
THUMB_WIDTH=320
PREVIEW_WIDTH=760
READER_WIDTH=1800
